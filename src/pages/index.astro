---
import { getRelativeLocaleUrl } from "astro:i18n";
import { DEFAULT_LOCALE, LOCALES } from "../lib/i18n";

const localeUrls = Object.fromEntries(
  LOCALES.map((locale) => [locale, getRelativeLocaleUrl(locale, "")]),
);
const fallbackUrl = localeUrls[DEFAULT_LOCALE];
---

<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Prime Harmony</title>
    <!-- Client-side redirect (works in static builds) -->
    <script define:vars={{ localeUrls, fallbackUrl }}>
      const browserLang = navigator.language.split("-")[0];
      window.location.replace(localeUrls[browserLang] ?? fallbackUrl);
    </script>
    <!-- Fallback for non-JS (meta refresh) -->
    <meta http-equiv="refresh" content={`0; url=${fallbackUrl}`} />
  </head>
  <body>
    Redirecting…
  </body>
</html>
