---
import { LanguagesIcon } from "@lucide/astro";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  currentLang?: string;
  availableLanguages: Record<string, string>;
}

const { currentLang, availableLanguages } = Astro.props;

const links = Object.entries(availableLanguages).map(([code, name]) => ({
  code,
  name,
  href: getRelativeLocaleUrl(code, ""),
}));
---

<details class="dropdown">
  <summary role="button">
    <LanguagesIcon />
  </summary>
  <ul role="listbox">
    {
      links.map(({ code, name, href }) => (
        <li>
          <a href={href} aria-current={code === currentLang ? "true" : undefined}>
            {name}
          </a>
        </li>
      ))
    }
  </ul>
</details>
