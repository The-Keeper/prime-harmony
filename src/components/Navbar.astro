---
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "../assets/logo.svg";
import LangSelect from "./LangSelect.astro";
import { LANGUAGE_NAMES, getContent, resolveLocale } from "../lib/i18n";

const currentLang = resolveLocale(Astro.currentLocale);
const content = getContent(currentLang);
---

<nav class="container-fluid">
  <ul>
    <li>
      <Logo fill="currentColor" />
    </li>
  </ul>
  <ul>
    <li><a href="#what">{content.nav.what}</a></li>
  </ul>
  <ul>
    {
      currentLang && (
        <li>
          <LangSelect
            currentLang={currentLang}
            availableLanguages={LANGUAGE_NAMES}
          />
        </li>
      )
    }
    <li><ThemeToggle locale={currentLang} /></li>
  </ul>
</nav>
