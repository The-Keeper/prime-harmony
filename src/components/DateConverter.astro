---
import SeasonCalendar from "./SeasonCalendar.astro";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const isRu = locale === "ru";

const t = isRu
  ? {
      g2p: "Григорианский → Первичная гармония",
      p2g: "Первичная гармония → Григорианский",
      gregorianDate: "Григорианская дата",
      year: "Год",
      season: "Сезон",
      festival: "Фестиваль",
      seasonN: (n: number) => `${n}-й сезон`,
      invalidCalendarDate: "Некорректная дата календаря",
    }
  : {
      g2p: "Gregorian → Prime Harmony",
      p2g: "Prime Harmony → Gregorian",
      gregorianDate: "Gregorian date",
      year: "Year",
      season: "Season",
      festival: "Festival",
      seasonN: (n: number) => `Season ${n}`,
      invalidCalendarDate: "Invalid calendar date",
    };

const seasons = [0, 1, 2, 3, 4];
---

<div
  data-date-converter
  data-locale={isRu ? "ru" : "en"}
  data-msg-invalid-calendar-date={t.invalidCalendarDate}
>
  <div role="group">
    <button type="button" data-mode="g2p" aria-pressed="true">{t.g2p}</button>
    <button type="button" data-mode="p2g" aria-pressed="false" class="outline">{t.p2g}</button>
  </div>

  <div data-panel="g2p">
    <label>
      {t.gregorianDate}
      <input type="date" data-gregorian />
    </label>
    <p><output data-prime-output aria-live="polite"></output></p>
  </div>

  <div data-panel="p2g" hidden>
    <div class="grid">
      <label>
        {t.year}
        <input type="number" step="1" data-year />
      </label>
      <label>
        {t.season}
        <select data-season>
          {seasons.map((value) => (
            <option value={value}>{value === 0 ? t.festival : t.seasonN(value)}</option>
          ))}
        </select>
      </label>
    </div>

    <SeasonCalendar interactive />

    <p><output data-gregorian-output aria-live="polite"></output></p>
  </div>
</div>

<script>
  import { PrimeHarmonyDate, isLeapYear } from "../lib/calendar";

  const formatPrime = (ph, locale) => {
    const cycleInfo = ph.cycleInfo();
    if (locale === "ru") {
      const body =
        ph.season === 0
          ? `Год ${ph.year}, ${ph.day + 1}-й праздничный день`
          : `Год ${ph.year}, ${ph.season}-й сезон, ${ph.day + 1}-й день из 90`;
      return `${body} (${cycleInfo.year}-й год ${cycleInfo.cycle}-го цикла)`;
    }
    const body =
      ph.season === 0
        ? `Year ${ph.year}, festival day ${ph.day + 1}`
        : `Year ${ph.year}, season ${ph.season}, day ${ph.day + 1} of 90`;
    return `${body} (year ${cycleInfo.year} of cycle ${cycleInfo.cycle})`;
  };

  document.querySelectorAll("[data-date-converter]").forEach((root) => {
    const locale = root.dataset.locale === "ru" ? "ru" : "en";
    const msgInvalidCalendarDate = root.dataset.msgInvalidCalendarDate;

    const tabs = root.querySelectorAll("[data-mode]");
    const panels = root.querySelectorAll("[data-panel]");
    const gregorianInput = root.querySelector("[data-gregorian]");
    const primeOutput = root.querySelector("[data-prime-output]");
    const gregorianOutput = root.querySelector("[data-gregorian-output]");
    const yearInput = root.querySelector("[data-year]");
    const seasonSelect = root.querySelector("[data-season]");
    const calendar = root.querySelector('[data-panel="p2g"] [data-season-calendar]');

    const state = { year: 0, season: 1, day: 1 };

    const setMode = (mode) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.mode === mode;
        tab.setAttribute("aria-pressed", String(active));
        tab.classList.toggle("outline", !active);
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== mode;
      });
    };

    const dayCount = () =>
      state.season === 0 ? (isLeapYear(state.year) ? 6 : 5) : 90;

    const syncCalendar = () => {
      calendar.dispatchEvent(
        new CustomEvent("season-calendar:set", {
          detail: { days: dayCount(), day: state.day },
        }),
      );
    };

    const updateGregorian = () => {
      try {
        const ph = new PrimeHarmonyDate(state.year, state.season, state.day - 1);
        gregorianOutput.textContent = ph.toDate().toISOString().slice(0, 10);
      } catch {
        gregorianOutput.textContent = msgInvalidCalendarDate;
      }
    };

    const sync = () => {
      const max = dayCount();
      if (state.day > max) state.day = max;
      if (state.day < 1) state.day = 1;
      yearInput.value = String(state.year);
      seasonSelect.value = String(state.season);
      syncCalendar();
      updateGregorian();
    };

    const convertGregorian = () => {
      const value = gregorianInput.value;
      const [year, month, day] = value.split("-").map(Number);
      if (!year || !month || !day) return;
      const ph = PrimeHarmonyDate.fromDate(new Date(Date.UTC(year, month - 1, day)));
      primeOutput.textContent = formatPrime(ph, locale);
    };

    calendar.addEventListener("season-calendar:change", (event) => {
      state.day = Number(event.detail.day);
      updateGregorian();
    });

    yearInput.addEventListener("input", () => {
      const value = Number.parseInt(yearInput.value, 10);
      if (Number.isNaN(value)) return;
      state.year = value;
      sync();
    });

    seasonSelect.addEventListener("change", () => {
      state.season = Number(seasonSelect.value);
      sync();
    });

    tabs.forEach((tab) => tab.addEventListener("click", () => setMode(tab.dataset.mode)));
    gregorianInput.addEventListener("input", convertGregorian);
    gregorianInput.addEventListener("change", convertGregorian);

    const now = new Date();
    const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
    const today = PrimeHarmonyDate.fromDate(new Date(todayIso));
    state.year = today.year;
    state.season = today.season;
    state.day = today.day + 1;
    gregorianInput.value = todayIso;
    setMode("g2p");

    // Wait for every component script to attach its listeners before syncing.
    setTimeout(() => {
      sync();
      convertGregorian();
    }, 0);
  });
</script>
