---
interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const isRu = locale === "ru";

const t = isRu
  ? {
      g2p: "Григорианский → Первичная гармония",
      p2g: "Первичная гармония → Григорианский",
      gregorianDate: "Григорианская дата",
      year: "Год",
      season: "Сезон",
      festival: "Фестиваль",
      seasonN: (n: number) => `${n}-й сезон`,
      day: "День",
      today: "Сегодня",
      invalidDate: "Некорректная дата",
      invalidCalendarDate: "Некорректная дата календаря",
    }
  : {
      g2p: "Gregorian → Prime Harmony",
      p2g: "Prime Harmony → Gregorian",
      gregorianDate: "Gregorian date",
      year: "Year",
      season: "Season",
      festival: "Festival",
      seasonN: (n: number) => `Season ${n}`,
      day: "Day",
      today: "Today",
      invalidDate: "Invalid date",
      invalidCalendarDate: "Invalid calendar date",
    };

const seasons = [0, 1, 2, 3, 4];
const days = Array.from({ length: 90 }, (_, i) => i + 1);
---

<div
  class="date-converter"
  data-date-converter
  data-locale={isRu ? "ru" : "en"}
  data-msg-invalid-date={t.invalidDate}
  data-msg-invalid-calendar-date={t.invalidCalendarDate}
>
  <div class="converter-tabs" role="group">
    <button type="button" data-mode="g2p" aria-pressed="true">{t.g2p}</button>
    <button type="button" data-mode="p2g" aria-pressed="false" class="outline">{t.p2g}</button>
  </div>

  <div class="converter-panel" data-panel="g2p">
    <label>
      {t.gregorianDate}
      <input type="date" data-gregorian />
    </label>
    <output data-output aria-live="polite"></output>
  </div>

  <div class="converter-panel" data-panel="p2g" hidden>
    <div class="prime-year-row">
      <label>
        {t.year}
        <input type="number" step="1" data-prime-year />
      </label>
      <div class="steppers" role="group">
        <button type="button" data-year-step="-1" aria-label="-1">&minus;</button>
        <button type="button" data-year-step="1" aria-label="+1">+</button>
      </div>
      <button type="button" class="outline" data-today>{t.today}</button>
    </div>

    <div class="picker-block">
      <span class="picker-label">{t.season}</span>
      <div class="season-picker" role="group" data-season-picker>
        {seasons.map((season) => (
          <button type="button" data-season={season} aria-pressed={season === 1}>
            {season === 0 ? t.festival : t.seasonN(season)}
          </button>
        ))}
      </div>
    </div>

    <div class="picker-block">
      <span class="picker-label">{t.day}</span>
      <div class="day-picker" data-day-picker>
        {days.map((day) => (
          <button type="button" data-day={day} aria-pressed={day === 1}>{day}</button>
        ))}
      </div>
    </div>

    <output data-output aria-live="polite"></output>
  </div>
</div>

<style>
  .date-converter {
    display: grid;
    gap: 0.75rem;
    margin: 1rem 0;
    max-width: 34rem;
  }
  .converter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .converter-tabs button {
    margin: 0;
  }
  .converter-panel {
    display: grid;
    gap: 0.75rem;
  }
  .converter-panel[hidden] {
    display: none;
  }
  .prime-year-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.5rem;
  }
  .prime-year-row label {
    flex: 1 1 8rem;
    margin: 0;
  }
  .steppers {
    display: flex;
    gap: 0.25rem;
  }
  .steppers button,
  .prime-year-row > button {
    margin: 0;
  }
  .picker-block {
    display: grid;
    gap: 0.3rem;
  }
  .picker-label {
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .season-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .day-picker {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 0.25rem;
  }
  .season-picker button,
  .day-picker button {
    margin: 0;
    width: auto;
    padding: 0.35rem 0.5rem;
    font-size: 0.85rem;
    line-height: 1;
    box-shadow: none;
    background: transparent;
    border: 1px solid var(--pico-muted-border-color);
    color: inherit;
  }
  .day-picker button {
    padding: 0;
    aspect-ratio: 1;
  }
  .season-picker button[aria-pressed="true"],
  .day-picker button[aria-pressed="true"] {
    background: var(--pico-primary-background);
    border-color: var(--pico-primary-background);
    color: white;
    font-weight: bold;
  }
  .day-picker button[hidden] {
    display: none;
  }
  .date-converter output {
    display: block;
    font-weight: bold;
  }
</style>

<script>
  import { PrimeHarmonyDate, isLeapYear } from "../lib/calendar";

  const formatPrime = (ph, locale) => {
    const cycleInfo = ph.cycleInfo();
    if (locale === "ru") {
      const body =
        ph.season === 0
          ? `Год ${ph.year}, ${ph.day + 1}-й праздничный день`
          : `Год ${ph.year}, ${ph.season}-й сезон, ${ph.day + 1}-й день из 90`;
      return `${body} (${cycleInfo.year}-й год ${cycleInfo.cycle}-го цикла)`;
    }
    const body =
      ph.season === 0
        ? `Year ${ph.year}, festival day ${ph.day + 1}`
        : `Year ${ph.year}, season ${ph.season}, day ${ph.day + 1} of 90`;
    return `${body} (year ${cycleInfo.year} of cycle ${cycleInfo.cycle})`;
  };

  document.querySelectorAll("[data-date-converter]").forEach((root) => {
    const locale = root.dataset.locale === "ru" ? "ru" : "en";
    const msgInvalidDate = root.dataset.msgInvalidDate;
    const msgInvalidCalendarDate = root.dataset.msgInvalidCalendarDate;

    const tabs = root.querySelectorAll("[data-mode]");
    const panels = root.querySelectorAll("[data-panel]");
    const gregorianInput = root.querySelector("[data-gregorian]");
    const gregorianOutput = root.querySelector('[data-panel="g2p"] [data-output]');
    const yearInput = root.querySelector("[data-prime-year]");
    const seasonButtons = root.querySelectorAll("[data-season]");
    const dayButtons = root.querySelectorAll("[data-day]");
    const primeOutput = root.querySelector('[data-panel="p2g"] [data-output]');

    const state = { year: 0, season: 1, day: 1 };

    const setMode = (mode) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.mode === mode;
        tab.setAttribute("aria-pressed", String(active));
        tab.classList.toggle("outline", !active);
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== mode;
      });
    };

    const dayCount = () =>
      state.season === 0 ? (isLeapYear(state.year) ? 6 : 5) : 90;

    const convertGregorian = () => {
      const value = gregorianInput.value;
      if (!value) {
        gregorianOutput.textContent = "";
        return;
      }
      const [year, month, day] = value.split("-").map(Number);
      if (!year || !month || !day) {
        gregorianOutput.textContent = msgInvalidDate;
        return;
      }
      const date = new Date(Date.UTC(year, month - 1, day));
      gregorianOutput.textContent = formatPrime(PrimeHarmonyDate.fromDate(date), locale);
    };

    const updatePrime = () => {
      try {
        const ph = new PrimeHarmonyDate(state.year, state.season, state.day - 1);
        primeOutput.textContent = ph.toDate().toISOString().slice(0, 10);
      } catch {
        primeOutput.textContent = msgInvalidCalendarDate;
      }
    };

    const renderPicker = () => {
      const max = dayCount();
      if (state.day > max) state.day = max;

      seasonButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(Number(button.dataset.season) === state.season));
      });
      dayButtons.forEach((button) => {
        const day = Number(button.dataset.day);
        button.hidden = day > max;
        button.setAttribute("aria-pressed", String(day === state.day));
      });
    };

    const refresh = () => {
      renderPicker();
      updatePrime();
    };

    const setYear = (year) => {
      if (!Number.isFinite(year)) return;
      state.year = year;
      yearInput.value = String(year);
      refresh();
    };

    tabs.forEach((tab) => tab.addEventListener("click", () => setMode(tab.dataset.mode)));
    gregorianInput.addEventListener("input", convertGregorian);
    gregorianInput.addEventListener("change", convertGregorian);

    yearInput.addEventListener("input", () => {
      const value = Number.parseInt(yearInput.value, 10);
      if (Number.isNaN(value)) return;
      state.year = value;
      refresh();
    });

    root.querySelectorAll("[data-year-step]").forEach((button) =>
      button.addEventListener("click", () =>
        setYear(state.year + Number(button.dataset.yearStep)),
      ),
    );

    seasonButtons.forEach((button) =>
      button.addEventListener("click", () => {
        state.season = Number(button.dataset.season);
        refresh();
      }),
    );

    dayButtons.forEach((button) =>
      button.addEventListener("click", () => {
        state.day = Number(button.dataset.day);
        refresh();
      }),
    );

    root.querySelector("[data-today]").addEventListener("click", () => {
      const now = new Date();
      const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
      const today = PrimeHarmonyDate.fromDate(new Date(todayIso));
      state.year = today.year;
      state.season = today.season;
      state.day = today.day + 1;
      yearInput.value = String(state.year);
      refresh();
    });

    const now = new Date();
    const todayIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
    gregorianInput.value = todayIso;
    const today = PrimeHarmonyDate.fromDate(new Date(todayIso));
    state.year = today.year;
    state.season = today.season;
    state.day = today.day + 1;
    yearInput.value = String(state.year);

    setMode("g2p");
    convertGregorian();
    refresh();
  });
</script>
